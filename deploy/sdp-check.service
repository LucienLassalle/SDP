[Unit]
Description=SDP - recherche de la dernière release sur GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sdp-check
Group=sdp-check
EnvironmentFile=-/opt/sdp/deploy/.env
ExecStart=/bin/bash /opt/sdp/deploy/check.sh
# /var/lib/sdp-check/latest-tag est lu par sdp-deploy (le tag est public)
StateDirectory=sdp-check
StateDirectoryMode=0755
UMask=0022
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProcSubset=pid
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
