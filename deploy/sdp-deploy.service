[Unit]
Description=SDP - déploiement de la dernière release
After=docker.service sdp-check.service
Requires=docker.service sdp-check.service

[Service]
Type=oneshot
User=sdp-deploy
# Groupe docker pour le socket et sdp-deploy pour le verrou partagé
Group=docker
SupplementaryGroups=sdp-deploy
WorkingDirectory=/opt/sdp
EnvironmentFile=-/opt/sdp/deploy/.env
Environment=LATEST_TAG_FILE=/var/lib/sdp-release-sync/source-tag
ExecStart=/bin/bash /opt/sdp/deploy/deploy.sh
# /var/lib/sdp-deploy : versions déployées et identifiants GHCR
StateDirectory=sdp-deploy
Environment=DOCKER_CONFIG=%S/sdp-deploy/docker
UMask=0077
ProtectSystem=strict
ReadWritePaths=-/var/lib/sdp-release-sync/deploy.lock
ProtectHome=yes
# Espace utilisateurs isolé : seuls le service et son groupe sont visibles
PrivateUsers=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProcSubset=pid
ProtectProc=invisible
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RemoveIPC=yes
# Aucun réseau : le service ne parle qu'au socket Docker (pull et healthchecks passent par dockerd)
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
