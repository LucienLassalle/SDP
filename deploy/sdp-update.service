[Unit]
Description=SDP - déploiement de la dernière release
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sdp
EnvironmentFile=-/opt/sdp/deploy/.env
ExecStart=/bin/bash /opt/sdp/deploy/update.sh
UMask=0077
ProtectSystem=strict
ReadWritePaths=/opt/sdp/deploy
ProtectHome=read-only
PrivateTmp=yes
