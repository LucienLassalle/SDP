<%- include('partials/header', { title: 'Forum' }) %>
<h1>Forum</h1>
<% if (user) { -%>
<form method="POST" action="/post">
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
  <textarea name="content" rows="3" placeholder="Votre message..."></textarea>
  <button type="submit">Publier</button>
</form>
<% } else { -%>
<p class="warn">Connectez-vous pour publier un message.</p>
<% } -%>
<hr>
<% messages.forEach((m) => { -%>
<div class="msg"><span class="author"><%= m.author %></span>
  <small><%= m.created_at %></small><p><%= m.content %></p></div>
<% }) -%>
<%- include('partials/footer') %>
