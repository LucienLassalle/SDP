<%- include('partials/header', { title: 'Mot de passe' }) %>
<div class="narrow">
<h1>Changer de mot de passe</h1>
<% if (locals.error) { -%>
<p class="warn"><%= error %></p>
<% } -%>
<% if (locals.done) { -%>
<p class="ok">Mot de passe modifié.</p>
<% } -%>
<form class="card" method="POST" action="/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
  <label for="current">Mot de passe actuel</label>
  <input name="current" type="password" id="current" autocomplete="current-password" required>
  <label for="password">Nouveau mot de passe</label>
  <input name="password" type="password" id="password" placeholder="<%= passwordMinLength %> caractères minimum" autocomplete="new-password" required>
  <label for="confirm">Confirmer le nouveau mot de passe</label>
  <input name="confirm" type="password" id="confirm" autocomplete="new-password" required>
  <button type="submit">Changer</button>
</form>
</div>
<%- include('partials/footer') %>
