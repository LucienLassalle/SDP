<%- include('partials/header', { title: 'Mot de passe' }) %>
<h1>Changer de mot de passe</h1>
<% if (locals.error) { -%>
<p class="warn"><%= error %></p>
<% } -%>
<% if (locals.done) { -%>
<p>Mot de passe modifié.</p>
<% } -%>
<form method="POST" action="/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
  <input name="current" type="password" placeholder="Mot de passe actuel" autocomplete="current-password">
  <input name="password" type="password" placeholder="Nouveau mot de passe (<%= passwordMinLength %> caractères minimum)" autocomplete="new-password">
  <input name="confirm" type="password" placeholder="Confirmer le nouveau mot de passe" autocomplete="new-password">
  <button type="submit">Changer</button>
</form>
<%- include('partials/footer') %>
